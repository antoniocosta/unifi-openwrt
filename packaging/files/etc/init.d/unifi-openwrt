#!/bin/sh /etc/rc.common
# unifi-openwrt: this OpenWrt AP as a UniFi AP (inform, adoption, settings).

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/uow
STATE=/etc/unifi-openwrt/state

start_service() {
	config_load unifi-openwrt
	local inform_every hw_caps mesh_uplink enabled model inform_url hostname apply profile_caps locate_beep ssh_port
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || { echo "unifi-openwrt disabled (uci set unifi-openwrt.main.enabled=1)"; return 0; }
	config_get model main model 'U7PG2'
	config_get inform_url main inform_url 'http://192.168.1.1:8080/inform'
	config_get hostname main hostname "$(uci -q get system.@system[0].hostname)"
	config_get_bool apply main apply 1
	config_get_bool profile_caps main profile_caps 1
	config_get_bool locate_beep main locate_beep 1
	config_get ssh_port main ssh_port 2222
	config_get_bool mesh_uplink main mesh_uplink 0
	config_get hw_caps main hw_caps 0
	config_get inform_every main inform_every 0
	config_get led_idle main led_idle ''
	mkdir -p "$STATE"; chmod 700 /etc/unifi-openwrt "$STATE"

	procd_open_instance
	procd_set_param command "$PROG" -ap local \
		-mac "$(cat /sys/class/net/br-lan/address)" \
		-model "$model" -hostname "${hostname:-OpenWrt}" -url "$inform_url" -state "$STATE" \
		-health-every 0 -ssh-listen ":$ssh_port" -stop-on-reset=false -portal-listen :8882 \
		-locate-beep=$([ "$locate_beep" = 1 ] && echo true || echo false)
	[ "$apply" = 1 ] && procd_append_param command -apply
	[ "$profile_caps" = 1 ] && procd_append_param command -profile-caps
	[ "$mesh_uplink" = 1 ] && procd_append_param command -mesh-uplink
	[ "$hw_caps" != 0 ] && procd_append_param command -hw-caps "$hw_caps"
	[ "$inform_every" != 0 ] && procd_append_param command -inform-every "${inform_every}s"
	[ -n "$led_idle" ] && procd_append_param command -led-idle "$led_idle"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# the mesh-uplink watcher runs on its own, so it keeps working without the daemon
	if [ "$mesh_uplink" = 1 ] && [ -x /etc/unifi-openwrt/mesh.sh ]; then
		procd_open_instance mesh
		procd_set_param command /etc/unifi-openwrt/mesh.sh
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
	# SNMP as the UniFi configures it (the daemon writes the config)
	if [ -s /etc/unifi-openwrt/snmpd.conf ] && [ -x /usr/sbin/snmpd ]; then
		mkdir -p /var/lib/snmp
		procd_open_instance snmp
		procd_set_param command /usr/sbin/snmpd -f -C -Lsd -c /etc/unifi-openwrt/snmpd.conf
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger unifi-openwrt
}
